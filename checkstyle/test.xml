<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="warning"/>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="ParameterNumber"><property name="max" value="5"/></module>
        <module name="MethodLength">
            <property name="max" value="120"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <!-- JUnit @RegisterExtension static final fixtures may use camelCase. -->
        <module name="ConstantName">
            <property name="format" value="^[a-zA-Z][a-zA-Z0-9]*$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="NestedIfDepth"><property name="max" value="3"/></module>
        <module name="NestedForDepth"><property name="max" value="3"/></module>
        <module name="CyclomaticComplexity"><property name="max" value="15"/></module>
    </module>
</module>
